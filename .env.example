# --- Telegram ---
BOT_TOKEN=123456:ABC...
# Telegram ID мастеров через запятую (кто может писать в таблицу). Пусто = все.
ALLOWED_USER_IDS=

# --- LLM: локальная модель через Ollama (OpenAI-совместимый API) ---
# Перед запуском: ollama pull qwen3:8b ; переменная Windows OLLAMA_CONTEXT_LENGTH=8192
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama            # Ollama ключ не проверяет, но клиенту нужна непустая строка
LLM_MODEL=qwen3:8b
LLM_TIMEOUT_S=120             # на CPU первый ответ может идти долго
LLM_MAX_TOKENS=2048           # предел длины ответа (меньше — быстрее отказ при «зацикливании»)
LLM_DISABLE_THINKING=true     # qwen3: выключить рассуждения (reasoning_effort=none), быстрее в ~2 раза

# Резервный облачный провайдер (необязательно), например OpenRouter :free
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=

# --- Распознавание голоса: локально faster-whisper ---
# pip install -e ".[voice]"   Модели: tiny / base / small / medium / large-v3
STT_PROVIDER=local            # local | api
STT_MODEL=small
STT_DEVICE=cpu                # cpu | cuda
# Для STT_PROVIDER=api (OpenAI-совместимый Whisper, например Groq):
STT_BASE_URL=
STT_API_KEY=

# --- Google Sheets ---
# JSON-ключ сервисного аккаунта; таблицу нужно расшарить на его e-mail (редактор)
GOOGLE_CREDENTIALS_FILE=credentials.json
SPREADSHEET_ID=1AbC...
WORKSHEET_NAME=Лист1
SYNONYMS_WORKSHEET_NAME=Синонимы

# --- Битрикс24 ---
# Входящий вебхук: https://<портал>.bitrix24.by/rest/<user_id>/<token>/
BITRIX_WEBHOOK_URL=
# entityTypeId смарт-процесса «Дневной отчёт»
BITRIX_ENTITY_TYPE_ID=

# --- Прочее ---
TIMEZONE=Europe/Minsk
DB_PATH=data/bot.sqlite3
LOG_LEVEL=INFO
