# Настройки для СЕРВЕРА (docker compose). Скопируйте в .env рядом с docker-compose.yml
# и заполните пустые значения. Отличие от локального .env — LLM через Groq, а не Ollama.
# Комментарии — только на отдельных строках.

# --- Telegram ---
BOT_TOKEN=
# Telegram ID мастеров через запятую. Пусто = бот отвечает всем.
ALLOWED_USER_IDS=

# --- LLM: Groq (OpenAI-совместимый API) ---
# Ключ тот же, что для голоса: console.groq.com → API Keys.
# Эталон проверен на qwen/qwen3.8-27b (scripts/eval_golden.py).
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=qwen/qwen3.8-27b
LLM_TIMEOUT_S=60
LLM_MAX_TOKENS=2048
# qwen3: без рассуждений (reasoning_effort=none) — Groq это принимает
LLM_DISABLE_THINKING=true

# Резерв на случай лимита Groq (8000 токенов в минуту на модель, ~2 отчёта в минуту).
# Можно указать другую модель Groq с тем же ключом — у моделей раздельные лимиты.
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=

# --- Голос: Whisper через Groq ---
STT_API_KEY=
STT_BASE_URL=https://api.groq.com/openai/v1
STT_MODEL=whisper-large-v3-turbo
STT_TIMEOUT_S=60

# --- Google Sheets ---
# Файл монтируется в контейнер как /app/credentials.json (см. docker-compose.yml)
GOOGLE_CREDENTIALS_FILE=credentials.json
SPREADSHEET_ID=
WORKSHEET_NAME=Лист1
SYNONYMS_WORKSHEET_NAME=Синонимы

# --- Битрикс24 ---
BITRIX_WEBHOOK_URL=
BITRIX_ENTITY_TYPE_ID=

# --- Прочее ---
TIMEZONE=Europe/Minsk
DB_PATH=data/bot.sqlite3
LOG_LEVEL=INFO
